// Tang Primer 20K Dock (motherboard) — 5" 800x480 RGB LCD

IO_LOC "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "sys_rst_n" T10;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Dock keys — 1.5V bank
IO_LOC "btn_left_n" T3;
IO_PORT "btn_left_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "btn_right_n" T2;
IO_PORT "btn_right_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "btn_thrust_n" D7;
IO_PORT "btn_thrust_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "btn_fire_n" C7;
IO_PORT "btn_fire_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;

IO_LOC "lcd_clk" R9;
IO_PORT "lcd_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "lcd_hsync" A15;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "lcd_vsync" D14;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "lcd_de" E15;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "lcd_bl" E10;
IO_PORT "lcd_bl" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "lcd_r[0]" L9;
IO_LOC "lcd_r[1]" N8;
IO_LOC "lcd_r[2]" N9;
IO_LOC "lcd_r[3]" N7;
IO_LOC "lcd_r[4]" N6;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "lcd_g[0]" D11;
IO_LOC "lcd_g[1]" A11;
IO_LOC "lcd_g[2]" B11;
IO_LOC "lcd_g[3]" P7;
IO_LOC "lcd_g[4]" R7;
IO_LOC "lcd_g[5]" D10;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "lcd_b[0]" B12;
IO_LOC "lcd_b[1]" C12;
IO_LOC "lcd_b[2]" B13;
IO_LOC "lcd_b[3]" A14;
IO_LOC "lcd_b[4]" B14;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 DRIVE=8;
